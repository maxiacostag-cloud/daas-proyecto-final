# =====================================================================
# Variables del docker-compose (S2-09).
# Copiar este archivo como .env (que NO se sube al repositorio) y reemplazar los valores.
# =====================================================================

# Usuario de Docker Hub donde están publicadas las imágenes y versión a usar (S2-10).
DOCKERHUB_USER=tu-usuario-de-docker-hub
IMAGE_TAG=1.0.0

# Credenciales de las tres bases MySQL (cada servicio tiene la suya).
DB_USER=logitrack
DB_PASSWORD=cambiar-esta-clave
MYSQL_ROOT_PASSWORD=cambiar-esta-clave-de-root

# Clave con la que security-service firma los JWT y shipment/courier los validan.
# Tiene que tener al menos 32 caracteres.
JWT_SECRET=cambiar-por-una-clave-larga-de-al-menos-32-caracteres
