<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.9</version>
        <relativePath/>
    </parent>

    <groupId>ar.edu.unju.fi.logitrack</groupId>
    <artifactId>daas-proyecto-final</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>daas-proyecto-final</name>
    <description>LogiTrack - Proyecto Agregador Multi-Módulo</description>

    <modules>
        <module>config-server</module>
        <module>shipment-service</module>
        <module>courier-service</module>
        <module>security-service</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <spring-cloud.version>2025.1.1</spring-cloud.version>
        <springdoc.version>3.2.0</springdoc.version>
        <jacoco.version>0.8.15</jacoco.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Prefijo de las imágenes que se publican en Docker Hub (S2-08 / S2-10) -->
        <docker.image.prefix>maxiacostag-cloud</docker.image.prefix>
    </properties>

    <!-- Gestión centralizada de versiones para todos los submódulos -->
    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud BOM (compatible con Spring Boot 4.0.x) -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- OpenAPI / Swagger -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Cada módulo ejecutable declara este plugin en su propio pom -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>

                <!-- Soporte para Mockito en versiones recientes de JDK.
                     @{argLine} lo completa jacoco:prepare-agent (S2-11). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>@{argLine} -XX:+EnableDynamicAgentLoading -Xshare:off</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Cobertura de tests (S2-11): instrumenta la JVM y genera
                 target/site/jacoco/ (HTML + XML) al final del ciclo verify. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>preparar-agente</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>reporte-cobertura</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
